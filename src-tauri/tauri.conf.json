{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tronix Launcher",
  "mainBinaryName": "tronix-launcher",
  "version": "0.1.0",
  "identifier": "com.tronix.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tronix Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#0A0B10",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https://*.steamgriddb.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**",
          "$APPDATA/details/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Tronix",
    "shortDescription": "Lance tes jeux et logiciels, vite.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
